# Copy to .env.local and adjust.

# Clerk authentication. Get these values from the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Learning service (Parent-Child-Bonding-Game-Backend, learning-service/).
# It defaults to port 8000 too, so start it on 8001:  uv run serve.py --local --port 8001
LEARNING_API_URL=http://10.247.10.19:8000

# Friends, presence and live duels (docs/SOCIAL_API.md). Unset: answered by this app's local stand-in.
# Set to "backend" once the backend serves /api/social/* at LEARNING_API_URL.
# SOCIAL_API=backend
