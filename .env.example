# Copy to .env.local and adjust.

# Auth, option 1: talk to Supabase Auth directly (used whenever both are set).
# Copy from the Supabase dashboard: Project Settings → API. The publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://maghucyjzvkawbjfgvrw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gGQRgaHJfdiKpLUAAjs7Fg_4QBgLlCo

# Auth, option 2: the auth API server (Parent-Child-Bonding-Game-Backend, app/). Used when the
# Supabase values above are empty. Demo mode: cp .env.demo.example .env there.
AUTH_API_URL=http://127.0.0.1:8000

# Learning service (Parent-Child-Bonding-Game-Backend, learning-service/).
# It defaults to port 8000 too, so start it on 8001:  uv run serve.py --local --port 8001
LEARNING_API_URL=http://10.247.10.19:8000

# Friends, presence and live duels (docs/SOCIAL_API.md). Unset: answered by this app's local stand-in.
# Set to "backend" once the backend serves /api/social/* at LEARNING_API_URL.
# SOCIAL_API=backend
