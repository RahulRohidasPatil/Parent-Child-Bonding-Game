# Copy to .env.local and adjust.

# Clerk authentication. Get these values from the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Learning service (Parent-Child-Bonding-Game-Backend, learning-service/).
# For a local backend: uv run uvicorn app.main:create_app --factory --port 8001
LEARNING_API_URL=http://10.247.10.19:8000

# Social endpoints always proxy to FastAPI at LEARNING_API_URL.
# Backend: configure CLERK_ISSUER and exact CLERK_AUTHORIZED_PARTIES.
# Clerk session claims must include player_id and username; see docs/SOCIAL_API.md.
